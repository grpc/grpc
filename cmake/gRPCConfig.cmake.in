# Module path
list(APPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR}/modules)

# Directory containing installed .proto files (e.g. grpc/health/v1/health.proto).
# Use as a protoc include path: -I ${gRPC_PROTOS_DIR}
if(IS_ABSOLUTE "@_gRPC_CMAKEDIR_TO_PROTOS@")
  # e.g. Windows with the cmake and share install dirs on different drives,
  # where no relative path exists.
  set(gRPC_PROTOS_DIR "@_gRPC_CMAKEDIR_TO_PROTOS@")
else()
  get_filename_component(gRPC_PROTOS_DIR
    "${CMAKE_CURRENT_LIST_DIR}/@_gRPC_CMAKEDIR_TO_PROTOS@" ABSOLUTE)
endif()

# Depend packages
@_gRPC_FIND_ZLIB@
@_gRPC_FIND_PROTOBUF@
@_gRPC_FIND_SSL@
@_gRPC_FIND_CARES@
@_gRPC_FIND_ABSL@
@_gRPC_FIND_RE2@
@_gRPC_FIND_OPENTELEMETRY@

# Targets
include(${CMAKE_CURRENT_LIST_DIR}/gRPCTargets.cmake)
if(NOT CMAKE_CROSSCOMPILING)
  include(${CMAKE_CURRENT_LIST_DIR}/gRPCPluginTargets.cmake)
endif()
