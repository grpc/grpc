module(name = "python_test_repo")

bazel_dep(name = "grpc", repo_name = "com_github_grpc_grpc")
local_path_override(
    module_name = "grpc",
    path = "../../../..",
)

# Tests that protos from another module can be used.
bazel_dep(name = "my_messages", repo_name = "some_other_repo")
local_path_override(
    module_name = "my_messages",
    path = "../python_second_test_repo",
)

# Versions match what grpc requires, so they do not affect version selection.
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "protobuf", version = "35.1", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_python", version = "2.2.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)
