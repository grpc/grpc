load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "deadlock_debug",
    testonly = True,
    srcs = [
        "__init__.py",
        "_deadlock_debug.py",
    ],
    imports = ["../"],
)

py_library(
    name = "concurrency_base",
    testonly = True,
    srcs = [
        "__init__.py",
        "_concurrency_base.py"
    ],
    imports = ["../"],
    deps = [
        ":deadlock_debug",
        "//src/python/grpcio/grpc:grpcio",
        "//src/python/grpcio_tests/tests/unit:test_common",
    ],
)

py_test(
    name = "health_concurrency_test",
    size = "medium",
    srcs = ["_health_concurrency_test.py"],
    imports = ["../"],
    main = "_health_concurrency_test.py",
    python_version = "PY3",
    deps = [
        ":concurrency_base",
        "//src/python/grpcio/grpc:grpcio",
        "//src/python/grpcio_health_checking/grpc_health/v1:grpc_health",
    ],
)

py_library(
    name = "async_concurrency_base",
    testonly = True,
    srcs = [
        "__init__.py",
        "_async_concurrency_base.py"
    ],
    imports = ["../"],
    deps = [
        ":deadlock_debug",
        "//src/python/grpcio/grpc:grpcio",
        "//src/python/grpcio_tests/tests_aio/unit:_test_base",
    ],
)

py_test(
    name = "async_health_concurrency_test",
    size = "medium",
    srcs = ["_async_health_concurrency_test.py"],
    imports = ["../"],
    main = "_async_health_concurrency_test.py",
    python_version = "PY3",
    deps = [
        ":async_concurrency_base",
        "//src/python/grpcio/grpc:grpcio",
        "//src/python/grpcio_health_checking/grpc_health/v1:grpc_health",
    ],
)
