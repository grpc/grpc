# The RBE toolchain uses a pre-release clang 19 that does not enable sized
# deallocation by default. riegeli (a fuzztest dependency) needs it.
#
# See also tools/dockerfile/test/rbe_ubuntu2004/Dockerfile
# TODO(weizheyuan): Update docker image to use 19.1.7 (last patch release)
# and remove this file
build --cxxopt=-fsized-deallocation
build --host_cxxopt=-fsized-deallocation
