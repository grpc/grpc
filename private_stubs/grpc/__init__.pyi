T = TypeVar('T')

class Future(abc.ABC, Generic[T]):
    @abc.abstractmethod
    def cancel(self) -> bool: ...
    @abc.abstractmethod
    def cancelled(self) -> bool: ...
    @abc.abstractmethod
    def running(self) -> bool: ...
    @abc.abstractmethod
    def done(self) -> bool: ...
    @abc.abstractmethod
    def result(self, timeout: Optional[float] = None) -> T: ...
    @abc.abstractmethod
    def exception(self, timeout: Optional[float] = None) -> Optional[BaseException]: ...
    @abc.abstractmethod
    def traceback(self, timeout: Optional[float] = None) -> Any: ...
    @abc.abstractmethod
    def add_done_callback(self, fn: Callable[['Future[T]'], None]) -> None: ...

