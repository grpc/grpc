# Build artifacts & compilation outputs
# Standard Bazel output symlinks
**/bazel-bin/
**/bazel-out/
**/bazel-testlogs/
# Workspace-specific symlinks (WORKSPACE & MODULE.bazel files)
**/bazel-grpc/
**/bazel-cpp/
**/bazel-python/
**/bazel-python_second_test_repo/
**/bazel-bzlmod_test/
**/bazel-artifact_gen/
# Root build outputs (/build/)
/build/
**/.build/
**/bins/
**/libs/
**/objs/
**/gens/
**/out/
**/dist/
# CMake CLion / IDE build directories
/cmake-build-*/
**/DerivedData/
# Generated build output packages (task_runner.py -f artifact -> /artifacts/)
/artifacts/

# System & generic cache
**/.cache/

# Git metadata
**/.git

# Python virtual environments, build artifacts & bytecode
**/pyb/
# Standard venvs (.venv, .venv-pyright, .venv-ci-black, etc.)
**/.venv*/
# TODO(sergiitk): update all references below to produce standard `.venv-*`
# User virtualenv dirs (src/python/CONTRIBUTING.md -> ~/.virtualenvs/)
**/.virtualenv*/
# Legacy venv directory names (build_artifact_python.sh, build_python.sh -> venv/)
**/venv/
# Script virtualenvs (tools/distrib/python/docgen.py -> distrib_virtualenv/)
**/*_virtualenv/
# Bazel format virtualenv (tools/distrib/format_bazel.sh -> bazel_format_virtual_environment/)
**/*_virtual_environment/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.pytype/
**/.coverage
**/.coverage.*
**/.mypy_cache/
**/.ruff_cache/
**/.eggs/
**/*.egg
**/*.egg-info/

# Node & Package Manager Dependencies
**/node_modules/
**/Pods/

# Editor & OS metadata
**/.DS_Store
**/Thumbs.db
**/._*
**/.idea/
**/.vscode/
**/.history/
# Vim swap files (*.sw?) and Emacs auto-save (/#*#) / lock files (/.#*)
**/*.sw?
**/#*#
**/.#*
**/*~

# Logs & Debug outputs
**/*.log
**/gdb.txt
**/portlog.txt
**/perf.data*

# Environment & Secrets safeguard
**/.env*
!**/.env.example
!**/.env.template
