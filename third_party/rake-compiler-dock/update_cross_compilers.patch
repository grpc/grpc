+<% if platform =~ /darwin/ %>
+RUN apt-get -y update && \
+    apt-get install -y wget && \
+    wget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key | gpg --dearmor > /usr/share/keyrings/llvm-snapshot.gpg && \
